# Headless GNU Octave 4.x built on a supported Ubuntu release.
#
# The build stage compiles Octave from source and the final stage only carries
# the shared libraries Octave links against, gnuplot for figures, and a C++
# toolchain so that `pkg install` can still compile .oct files.

FROM ubuntu:24.04 AS build

ARG OCTAVE_VERSION

RUN apt-get --yes update && \
    DEBIAN_FRONTEND=noninteractive \
    apt-get --no-install-recommends --yes install \
      autoconf \
      automake \
      bison \
      build-essential \
      ca-certificates \
      flex \
      gfortran \
      gperf \
      libarpack2-dev \
      libbz2-dev \
      libcurl4-gnutls-dev \
      libfftw3-dev \
      libglpk-dev \
      libgraphicsmagick++1-dev \
      libhdf5-dev \
      liblapack-dev \
      libncurses-dev \
      libopenblas-dev \
      libpcre3-dev \
      libqhull-dev \
      libqrupdate-dev \
      libreadline-dev \
      libsndfile1-dev \
      libsuitesparse-dev \
      libtool \
      patch \
      perl \
      pkg-config \
      wget \
      zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

COPY patches/${OCTAVE_VERSION} /tmp/patches

# Octave 4.2 predates C++17 and GCC 10's stricter Fortran argument checks
RUN mkdir -p /tmp/build && \
    cd /tmp/build && \
    wget -q "https://ftpmirror.gnu.org/octave/octave-${OCTAVE_VERSION}.tar.gz" && \
    tar -xf "octave-${OCTAVE_VERSION}.tar.gz" && \
    cd "octave-${OCTAVE_VERSION}" && \
    for patch in /tmp/patches/*.patch; do patch -p1 < "${patch}"; done && \
    ./configure \
      CFLAGS="-O2" \
      CXXFLAGS="-O2 -std=gnu++11" \
      FFLAGS="-O2 -fallow-argument-mismatch" \
      --disable-docs \
      --disable-java \
      --without-qt \
      --without-fltk \
      --without-opengl \
      --without-osmesa \
      --without-portaudio && \
    make -j"$(nproc)" && \
    make install && \
    rm -rf /tmp/build /tmp/patches

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Record which system packages provide the shared libraries Octave links
# against. Packages may register their files under either /lib or /usr/lib so
# match on both.
RUN { find /usr/local -type f \( -name "*.so*" -o -name "*.oct" -o -perm -u+x \) \
        -exec ldd {} + 2>/dev/null || true; } | \
    awk '/=> \// { print $3 }' | \
    grep -v "^/usr/local/" | \
    sort -u | \
    xargs realpath | \
    sed -e "s|^/usr||" -e "s|^|*|" | \
    xargs dpkg -S | \
    grep -v "^diversion by " | \
    cut -d: -f1 | \
    sort -u > /usr/local/share/octave-runtime-packages.txt


FROM ubuntu:24.04

LABEL maintainer="Jonathan Suever <suever@gmail.com>"

COPY --from=build /usr/local /usr/local

RUN apt-get --yes update && \
    apt-get --yes upgrade && \
    DEBIAN_FRONTEND=noninteractive \
    apt-get --no-install-recommends --yes install \
      $(cat /usr/local/share/octave-runtime-packages.txt) \
      ca-certificates \
      g++ \
      gnuplot-nox \
      locales \
      make \
      wget && \
    rm -rf /var/lib/apt/lists/* && \
    ldconfig

RUN echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && \
    locale-gen

ARG NB_USER="octave"
ARG NB_UID="1111"

ENV LC_ALL=en_US.UTF-8 \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US.UTF-8 \
    HOME="/home/${NB_USER}"

RUN useradd -l -m -s /bin/bash -u "${NB_UID}" "${NB_USER}"

USER ${NB_UID}

WORKDIR "${HOME}"

CMD ["octave-cli"]
